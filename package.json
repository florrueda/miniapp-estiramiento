{
  "name": "miniapp-estiramiento",
  "version": "1.0.0",
  "description": "Una mini Flor que tipea en la esquina de la pantalla y cada 30 minutos te recuerda estirarte.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.flor.miniapp-estiramiento",
    "productName": "Mini Flor",
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "assets/**"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": { "target": "dmg", "arch": "universal" }, "category": "public.app-category.healthcare-fitness" }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
